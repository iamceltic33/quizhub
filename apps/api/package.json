    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.21",
    "express": "4.21.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.0",
    "tsdown": "0.12.0",
    "tsx": "^4.19.4",
    "typescript": "5.9.3"
