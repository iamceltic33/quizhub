{
  "name": "quizhub-api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.cjs",
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
